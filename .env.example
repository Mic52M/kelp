# ─── Kelp environment (copy to .env.local, never commit real values) ──────────

# Our application Postgres (Supabase or plain Postgres). The web app connects as
# the "authenticated" role (RLS enforced); the worker uses a privileged role.
DATABASE_URL="postgresql://user:pass@localhost:5432/kelp"
DATABASE_URL_WORKER="postgresql://kelp_worker:pass@localhost:5432/kelp"

# User authentication (pick one integration; see README).
# Supabase Auth:
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""   # server-side only, worker

# Encryption key for customer credentials at rest (32-byte, base64).
# Generate: openssl rand -base64 32
KELP_CREDENTIAL_ENC_KEY=""

# GitHub App (install flow + repo read + PR creation).
# Scope: read repo contents + write PRs only.
GITHUB_APP_ID=""
GITHUB_APP_CLIENT_ID=""
GITHUB_APP_CLIENT_SECRET=""
GITHUB_APP_PRIVATE_KEY_BASE64=""  # PEM, base64-encoded
# Set to any strong random string; use the same value in the GitHub App's
# Webhook settings (Webhook URL: <APP_URL>/api/github/webhook, event: Push).
GITHUB_WEBHOOK_SECRET=""
# Optional dev fallback only. Users now install the app themselves and we store
# their installation per org (issue #14); this single id is used only when an org
# has registered no installation yet. Leave empty in production.
# GitHub App config: set the post-install "Setup URL" to
#   <APP_URL>/api/github/setup  (locally http://localhost:3000/api/github/setup)
GITHUB_APP_INSTALLATION_ID=""

# Anthropic API (reasoning layer on top of the deterministic scanners).
# Two-model strategy: a strong model for planning/agentic tool-use/fix generation,
# a cheap fast model for high-volume explanations and triage.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_REASONING="claude-opus-4-8"
ANTHROPIC_MODEL_CHEAP="claude-haiku-4-5"

# Stripe (subscription billing).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_AGENCY=""

# Job queue (worker). Redis or Postgres-backed queue.
REDIS_URL=""

{
  "name": "@kelp/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Kelp scan worker — long-running jobs (RLS/secret/BOLA). Deploys to Railway/Fly.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/index.js",
    "demo": "node dist/demo.js",
    "verify:bola-target": "node dist/agent/verify-bola-target.js",
    "verify:auth-bypass-target": "node dist/agent/verify-auth-bypass-target.js",
    "verify:injection-target": "node dist/agent/verify-injection-target.js",
    "verify:ssrf-target": "node dist/agent/verify-ssrf-target.js",
    "verify:exposure-target": "node dist/agent/verify-exposure-target.js",
    "verify:rls-deep-target": "node dist/agent/verify-rls-deep-target.js",
    "verify:weak-crypto-target": "node dist/agent/verify-weak-crypto-target.js",
    "verify:edge-backends": "node dist/agent/verify-edge-backends.js",
    "verify:cost-accounting": "node dist/agent/verify-cost-accounting.js",
    "verify:bola-target-live": "node dist/agent/verify-bola-target-live.js",
    "verify:auth-bypass-target-live": "node dist/agent/verify-auth-bypass-target-live.js",
    "verify:injection-target-live": "node dist/agent/verify-injection-target-live.js",
    "verify:ssrf-target-live": "node dist/agent/verify-ssrf-target-live.js",
    "verify:exposure-target-live": "node dist/agent/verify-exposure-target-live.js",
    "verify:rls-deep-target-live": "node dist/agent/verify-rls-deep-target-live.js",
    "verify:weak-crypto-target-live": "node dist/agent/verify-weak-crypto-target-live.js",
    "verify:live": "npm run verify:bola-target-live && npm run verify:auth-bypass-target-live && npm run verify:injection-target-live && npm run verify:ssrf-target-live && npm run verify:exposure-target-live && npm run verify:rls-deep-target-live && npm run verify:weak-crypto-target-live",
    "verify:campaign-e2e": "node dist/agent/verify-campaign-e2e.js",
    "verify:triage": "node dist/agent/verify-triage.js",
    "verify:auth-model": "node dist/agent/verify-auth-model.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.109.1",
    "@kelp/core": "*",
    "@octokit/app": "^16.1.2",
    "bullmq": "^5.79.3",
    "pg": "^8.22.0",
    "stripe": "^22.3.0",
    "tar-stream": "^3.2.0"
  },
  "devDependencies": {
    "@types/pg": "^8.20.0",
    "@types/tar-stream": "^3.1.4"
  }
}
